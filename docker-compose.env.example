# Copy the lines you need into .env on the server. Do not commit .env.

# Current production default:
# - ch-chang.yssnooker.com -> golang-demo1
# - neverdie.yssnooker.com -> golang-neverdie
# - om.yssnooker.com -> golang-demo1
# This keeps the existing separate-server layout working without any .env.

# Use this when ch-chang and om must run on the same server with separate DBs.
# BACKEND_OM=golang-om
# UPLOAD_ROOT_OM=/srv/uploads/om

# Optional: set these only when you want to keep an existing activated
# license that was generated from the old container machine_id.
# MACHINE_ID_DEMO1=paste-existing-machine-id-here
# MACHINE_ID_NEVERDIE=paste-existing-machine-id-here
# MACHINE_ID_OM=paste-existing-machine-id-here

# MQTT relay config. Put real passwords only in the server .env.
# Backend publishes binary Modbus relay commands; frontend does not connect to MQTT.
# When MQTT_RELAY_REQUIRED_* is true, backend blocks app usage until MQTT
# validates. Leave it unset/false when the old local lighting fallback
# (VITE_LIGHTING_BACKEND_URL, usually http://localhost:9090) should still work.
# Emergency skip writes MQTT_RELAY_DISABLED=true into data/<site>/config/site.env.
# DEMO1 is ch-chang on the shared production server.
# MQTT_RELAY_DISABLED_DEMO1=false
# MQTT_RELAY_REQUIRED_DEMO1=true
# SYSTEM_CONFIG_ALLOW_UPDATE_DEMO1=false
# MQTT_RELAY_BROKER_DEMO1=tcp://mqtt-broker.example.com:1883
# MQTT_RELAY_USERNAME_DEMO1=backend_chorchang_1
# MQTT_RELAY_PASSWORD_DEMO1=paste-secret-on-server-only
# MQTT_RELAY_CLIENT_ID_DEMO1=snooker-chorchang-backend-1
# MQTT_RELAY_CMD_TOPIC_DEMO1=snooker/chorchang/1/hardware/1/relay/cmd
# MQTT_RELAY_RESP_TOPIC_DEMO1=snooker/chorchang/1/hardware/1/relay/resp
# MQTT_RELAY_QOS_DEMO1=1
# MQTT_RELAY_TIMEOUT_MS_DEMO1=2000

# MQTT_RELAY_DISABLED_NEVERDIE=false
# MQTT_RELAY_REQUIRED_NEVERDIE=false
# SYSTEM_CONFIG_ALLOW_UPDATE_NEVERDIE=false
# MQTT_RELAY_BROKER_NEVERDIE=tcp://mqtt-broker.example.com:1883
# MQTT_RELAY_USERNAME_NEVERDIE=backend_neverdie_1
# MQTT_RELAY_PASSWORD_NEVERDIE=paste-secret-on-server-only
# MQTT_RELAY_CLIENT_ID_NEVERDIE=snooker-neverdie-backend-1
# MQTT_RELAY_CMD_TOPIC_NEVERDIE=snooker/neverdie/1/hardware/1/relay/cmd
# MQTT_RELAY_RESP_TOPIC_NEVERDIE=snooker/neverdie/1/hardware/1/relay/resp
# MQTT_RELAY_QOS_NEVERDIE=1
# MQTT_RELAY_TIMEOUT_MS_NEVERDIE=2000

# MQTT_RELAY_DISABLED_OM=false
# MQTT_RELAY_REQUIRED_OM=true
# SYSTEM_CONFIG_ALLOW_UPDATE_OM=false
# MQTT_RELAY_BROKER_OM=tcp://mqtt-broker.example.com:1883
# MQTT_RELAY_USERNAME_OM=backend_om_1
# MQTT_RELAY_PASSWORD_OM=paste-secret-on-server-only
# MQTT_RELAY_CLIENT_ID_OM=snooker-om-backend-1
# MQTT_RELAY_CMD_TOPIC_OM=snooker/om/1/hardware/1/relay/cmd
# MQTT_RELAY_RESP_TOPIC_OM=snooker/om/1/hardware/1/relay/resp
# MQTT_RELAY_QOS_OM=1
# MQTT_RELAY_TIMEOUT_MS_OM=2000

# Use this when ch-chang uploads should also be isolated under data/uploads/demo1.
# Move existing ch-chang upload files before enabling these two lines.
# UPLOADS_DEMO1_PATH=./data/uploads/demo1
# UPLOAD_ROOT_CH_CHANG=/srv/uploads/demo1

# Fourth site slot. Change the host and DB/upload paths as needed.
# SITE4_HOST=site4.yssnooker.com
# BACKEND_SITE4=golang-site4
# UPLOAD_ROOT_SITE4=/srv/uploads/site4
# DB_SITE4_PATH=./data/site4/snooker.db
# UPLOADS_SITE4_PATH=./data/uploads/site4
# LICENSE_SITE4_PATH=./data/site4/license
# MACHINE_ID_SITE4=paste-existing-machine-id-here
# MACHINE_ID_SEED_SITE4=snooker-site4
