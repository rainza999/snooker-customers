# Copy this file to .env on the demo server. Do not commit the real .env.

DEMO1_HOST=demo1.yssnooker.com
DEMO2_HOST=demo2.yssnooker.com
DEMO3_HOST=demo3.yssnooker.com
DEMO4_HOST=demo4.yssnooker.com

# Generate four different long random values on the server:
#   openssl rand -hex 32
JWT_SECRET_DEMO1=replace-with-random-value
JWT_SECRET_DEMO2=replace-with-random-value
JWT_SECRET_DEMO3=replace-with-random-value
JWT_SECRET_DEMO4=replace-with-random-value

# Stable defaults are already provided by docker-compose.demo.yml.
# Only set explicit MACHINE_ID values when migrating existing activated licenses.
# MACHINE_ID_DEMO1=paste-existing-machine-id
# MACHINE_ID_DEMO2=paste-existing-machine-id
# MACHINE_ID_DEMO3=paste-existing-machine-id
# MACHINE_ID_DEMO4=paste-existing-machine-id

# Demo sites skip MQTT setup by default. Override per site when hardware is ready.
# MQTT_RELAY_DISABLED_DEMO1=true
# MQTT_RELAY_DISABLED_DEMO2=true
# MQTT_RELAY_DISABLED_DEMO3=true
# MQTT_RELAY_DISABLED_DEMO4=true
