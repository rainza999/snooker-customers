# Copy this file to .env on the dev server. Do not commit the real .env.

DEV_HOST=dev.yssnooker.com
RAIN_HOST=rain.yssnooker.com
SMART_HOME_HOST=smart-home.yssnooker.com
ARAYASUJIN_HOST=arayasujin.yssnooker.com

# Generate four different long random values on the server:
#   openssl rand -hex 32
JWT_SECRET_DEV=replace-with-random-value
JWT_SECRET_RAIN=replace-with-random-value
JWT_SECRET_SMART_HOME=replace-with-random-value
JWT_SECRET_ARAYASUJIN=replace-with-random-value

# Stable defaults are already provided by docker-compose.dev.yml.
# Only set explicit MACHINE_ID values when migrating existing activated licenses.
# MACHINE_ID_DEV=paste-existing-machine-id
# MACHINE_ID_RAIN=paste-existing-machine-id
# MACHINE_ID_SMART_HOME=paste-existing-machine-id
# MACHINE_ID_ARAYASUJIN=paste-existing-machine-id

# Dev sites skip MQTT setup by default. Override per site when hardware is ready.
# MQTT_RELAY_DISABLED_DEV=true
# MQTT_RELAY_DISABLED_RAIN=true
# MQTT_RELAY_DISABLED_SMART_HOME=true
# MQTT_RELAY_DISABLED_ARAYASUJIN=true
